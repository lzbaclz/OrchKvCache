%% For now, fall back to plain bibliography style.
ENTRY { author title journal year booktitle volume number pages doi url publisher address note howpublished } {} { label }
FUNCTION {not} { { #0 } { #1 } if$ }
FUNCTION {article} { "" }
FUNCTION {inproceedings} { "" }
FUNCTION {misc} { "" }
FUNCTION {default.type} { "" }
READ
